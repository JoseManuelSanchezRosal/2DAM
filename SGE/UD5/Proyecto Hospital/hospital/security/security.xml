<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="module_category_hospital" model="ir.module.category">
            <field name="name">Gestión Hospitalaria</field>
            <field name="description">Nivel de acceso para el sistema del hospital</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_hospital_user" model="res.groups">
            <field name="name">Usuario / Recepcionista</field>
            <field name="category_id" ref="module_category_hospital"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Este usuario puede gestionar citas y consultar médicos/especialidades.</field>
        </record>

        <record id="group_hospital_manager" model="res.groups">
            <field name="name">Administrador / Responsable</field>
            <field name="category_id" ref="module_category_hospital"/>
            <field name="implied_ids" eval="[(4, ref('group_hospital_user'))]"/>
            <field name="comment">Acceso total para configurar el centro (especialidades y médicos).</field>
        </record>
    </data>
</odoo>