<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <View
        android:id="@+id/rectangulo"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:background="#84C75E"
        android:layout_centerInParent="true"
        />

    <Button
        android:id="@+id/buttonArriba"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ARRIBA"
        android:layout_below="@+id/rectangulo"
        android:layout_centerInParent="true"
        android:layout_marginTop="20dp"
        />

    <Button
        android:id="@+id/buttonAbajo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ABAJO"
        android:layout_below="@+id/buttonArriba"
        android:layout_centerInParent="true"
        android:layout_marginTop="70dp"
        />

    <Button
        android:id="@+id/buttonIzquierda"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="IZQUIERDA"
        android:layout_below="@+id/buttonArriba"
        android:layout_toStartOf="@+id/buttonArriba"
        android:layout_centerInParent="true"
        android:layout_marginTop="10dp"
        />

    <Button
        android:id="@+id/buttonDerecha"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DERECHA"
        android:layout_below="@+id/buttonArriba"
        android:layout_toEndOf="@+id/buttonArriba"
        android:layout_centerInParent="true"
        android:layout_marginTop="10dp"
        />

    <Button
        android:id="@+id/buttonColor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/buttonArriba"
        android:layout_centerInParent="true"
        android:layout_marginStart="1dp"
        android:layout_marginTop="127dp"
        android:layout_toEndOf="@+id/buttonArriba"
        android:text=" COLOR " />

    <Button
        android:id="@+id/buttonTamano"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/buttonArriba"
        android:layout_centerInParent="true"
        android:layout_marginTop="129dp"
        android:layout_marginEnd="1dp"
        android:layout_toStartOf="@+id/buttonArriba"
        android:text="TAMANIO" />

    <Button
        android:id="@+id/buttonCambioColorBorde"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/buttonArriba"
        android:layout_centerInParent="true"
        android:layout_marginStart="-129dp"
        android:layout_marginTop="172dp"
        android:layout_toEndOf="@+id/buttonArriba"
        android:text=" CambioCBorde " />


</RelativeLayout>