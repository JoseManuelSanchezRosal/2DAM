<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="fridgeapp.controller.AlimentosController" styleClass="root">
    <top>
        <Label text="Alimentos en el frigorífico" styleClass="title-small" BorderPane.alignment="CENTER"/>
    </top>
    <center>
        <TableView fx:id="tablaAlimentos" prefHeight="320" prefWidth="640">
            <columns>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="200"/>
                <TableColumn fx:id="colTipo" text="Tipo" prefWidth="160"/>
                <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="140"/>
                <TableColumn fx:id="colUnidad" text="Unidad" prefWidth="140"/>
            </columns>
        </TableView>
    </center>
    <bottom>
        <HBox spacing="12" alignment="CENTER" style="-fx-padding: 12;">
            <Button text="Añadir" onAction="#agregarAlimento" styleClass="primary"/>
            <Button text="Modificar" onAction="#modificarAlimento" styleClass="primary"/>
            <Button text="Eliminar" onAction="#eliminarAlimento" styleClass="danger"/>
            <Button text="Volver" onAction="#volverMenu" styleClass="secondary"/>
        </HBox>
    </bottom>
</BorderPane>
