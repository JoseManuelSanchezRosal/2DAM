<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="fridgeapp.controller.AjustesController"
      alignment="CENTER_LEFT" spacing="12" styleClass="root" style="-fx-padding: 24;">
    <Label text="Ajustes del Frigorífico" styleClass="title-small"/>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Temperatura (°C):"/>
        <TextField fx:id="txtTemperatura" promptText="Ej: 4" prefWidth="80"/>
    </HBox>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Modo:"/>
        <ChoiceBox fx:id="cbModo" prefWidth="140"/>
    </HBox>
    <HBox spacing="10">
        <Button text="Guardar ajustes" onAction="#guardarAjustes" styleClass="primary"/>
        <Button text="Volver al menú" onAction="#volverMenu" styleClass="secondary"/>
    </HBox>
</VBox>
