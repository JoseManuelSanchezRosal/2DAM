<?xml version="1.0" encoding="UTF-8"?>

<!-- 
    Archivo FXML que define la interfaz gráfica de la aplicación JavaFX.
    Muestra un formulario para introducir datos de una persona (nombre, apellidos, edad)
    y una tabla donde se listan todas las personas agregadas.
-->

<!-- Importaciones de los componentes de JavaFX que se van a utilizar -->
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<!-- 
    Nodo raíz de la interfaz: AnchorPane
    Es un tipo de contenedor que permite posicionar los elementos por coordenadas (layoutX, layoutY).
    Se define además el controlador asociado a este FXML.
-->
<AnchorPane 
    id="AnchorPane" 
    prefHeight="443.0" 
    prefWidth="660.0" 
    xmlns="http://javafx.com/javafx/24.0.1" 
    xmlns:fx="http://javafx.com/fxml/1" 
    fx:controller="Controlador.Vista1Controller">
   
   <!-- 
       Dentro del AnchorPane se incluyen todos los elementos visuales (nodos hijos).
   -->
   <children>
      
      <!-- Etiqueta para el campo "Nombre" -->
      <Label layoutX="40.0" layoutY="35.0" text="Nombre" />
      
      <!-- Etiqueta para el campo "Apellidos" -->
      <Label layoutX="40.0" layoutY="133.0" text="Apellidos" />
      
      <!-- Etiqueta para el campo "Edad" -->
      <Label layoutX="40.0" layoutY="234.0" text="Edad" />
      
      <!-- Campo de texto para introducir el nombre -->
      <!-- El atributo fx:id enlaza este TextField con la variable 'tNombre' del controlador -->
      <TextField fx:id="tNombre" layoutX="40.0" layoutY="53.0" prefHeight="25.0" prefWidth="176.0" />
      
      <!-- Campo de texto para introducir la edad -->
      <!-- Se enlaza con 'tEdad' del controlador -->
      <TextField fx:id="tEdad" layoutX="40.0" layoutY="252.0" prefHeight="25.0" prefWidth="176.0" />
      
      <!-- Campo de texto para introducir los apellidos -->
      <!-- Se enlaza con 'tApellidos' del controlador -->
      <TextField fx:id="tApellidos" layoutX="40.0" layoutY="151.0" prefHeight="25.0" prefWidth="176.0" />
      
      <!-- Botón para agregar una persona -->
      <!-- onMouseClicked indica que al hacer clic se ejecutará el método 'agregar' del controlador -->
      <Button 
          fx:id="btn" 
          layoutX="41.0" 
          layoutY="334.0" 
          mnemonicParsing="false" 
          onMouseClicked="#agregar" 
          text="Agregar persona" />
      
      <!-- Tabla donde se mostrarán las personas -->
      <!-- fx:id enlaza la tabla con 'tablaPers' del controlador -->
      <!-- onMouseClicked="#seleccionarPers" ejecuta el método 'seleccionarPers' al hacer clic en una fila -->
      <TableView 
          fx:id="tablaPers" 
          layoutX="246.0" 
          layoutY="39.0" 
          onMouseClicked="#seleccionarPers" 
          prefHeight="332.0" 
          prefWidth="392.0">
          
          <!-- Definición de las columnas de la tabla -->
          <columns>
              <!-- Columna para mostrar el nombre -->
              <!-- fx:id se enlaza con 'colNombre' en el controlador -->
              <TableColumn fx:id="colNombre" prefWidth="130.0" text="Nombre" />
              
              <!-- Columna para mostrar los apellidos -->
              <!-- fx:id se enlaza con 'colApellidos' -->
              <TableColumn fx:id="colApellidos" prefWidth="133.3" text="Apellidos" />
              
              <!-- Columna para mostrar la edad -->
              <!-- fx:id se enlaza con 'colEdad' -->
              <TableColumn fx:id="colEdad" prefWidth="127.3" text="Edad" />
          </columns>
      </TableView>
      
      <!-- Botón para modificar una persona seleccionada en la tabla -->
      <!-- Llama al método 'modificarPers' del controlador -->
      <Button 
          fx:id="btnMod" 
          layoutX="294.0" 
          layoutY="392.0" 
          mnemonicParsing="false" 
          onMouseClicked="#modificarPers" 
          text="Modificar persona" />
      
      <!-- Botón para eliminar una persona seleccionada -->
      <!-- Llama al método 'eliminarPers' del controlador -->
      <Button 
          fx:id="btnEliminar" 
          layoutX="485.0" 
          layoutY="392.0" 
          mnemonicParsing="false" 
          onMouseClicked="#eliminarPers" 
          text="Eliminar persona" />
   
   </children>
</AnchorPane>
