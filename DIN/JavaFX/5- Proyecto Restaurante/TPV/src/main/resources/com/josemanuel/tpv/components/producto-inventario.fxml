<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<fx:root spacing="10.0" style="-fx-border-color: black; -fx-border-width: 1px;" type="HBox" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1">
    <ImageView fx:id="imageViewProducto" fitHeight="90.0" fitWidth="90.0" pickOnBounds="true" preserveRatio="true" />
    <VBox alignment="CENTER_LEFT" prefHeight="71.0" prefWidth="100.0" spacing="5.0">
        <children>
         <TextField fx:id="textFieldNombre" />
         <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="5.0">
            <children>
                <TextField fx:id="textFieldPrecio" prefHeight="41.0" prefWidth="100.0" />
               <Label text="€">
                  <font>
                     <Font name="System Bold" size="12.0" />
                  </font></Label>
            </children>
         </HBox>
          <HBox prefHeight="26.0" prefWidth="100.0">
              <children>
                  <Button fx:id="buttonDecrementarCantidad" mnemonicParsing="false" prefHeight="30.0" prefWidth="30.0" text="-" />
                  <TextField fx:id="textFieldStock" alignment="CENTER" minWidth="40.0" prefHeight="30.0" prefWidth="35.0" />
                  <Button fx:id="buttonIncrementarCantidad" mnemonicParsing="false" prefHeight="30.0" prefWidth="30.0" text="＋" />
              </children>
          </HBox>
        </children>
    </VBox>
   <padding>
      <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
   </padding>
</fx:root>
