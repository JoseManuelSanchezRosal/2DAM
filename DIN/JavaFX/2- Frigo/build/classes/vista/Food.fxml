<AnchorPane fx:id="anchorAlimentos" prefHeight="691.0" prefWidth="480.0" stylesheets="@../style/newCascadeStyleSheet.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.FoodController">
